# Ячейка 1: Импорты
import torch
from PIL import Image
from torchvision import transforms
from models.deepfake_detector import DeepFakeDetector
import matplotlib.pyplot as plt

# Ячейка 2: Загрузка модели
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
model = DeepFakeDetector().to(device)
model.load_state_dict(torch.load("weights/best_model.pth", map_location=device))
model.eval()

# Ячейка 3: Функция предсказания
def predict(image_path, threshold=0.45):
    transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
    ])
    img = Image.open(image_path).convert('RGB')
    img_tensor = transform(img).unsqueeze(0).to(device)
    with torch.no_grad():
        logits = model(img_tensor)
        prob = torch.sigmoid(logits).item()
    label = "FAKE" if prob > threshold else "REAL"
    return label, prob, img

# Ячейка 4: Тест на примере
image_path = "examples/real.jpg"  # путь к картинке
label, prob, img = predict(image_path)
plt.imshow(img)
plt.title(f"{label} (conf: {prob:.4f})")
plt.axis('off')
plt.show()
print(f"Result: {label} (confidence: {prob:.4f})")
